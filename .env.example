# Copy to .env and fill in real values. Never commit .env or credential JSON.

GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
GOOGLE_SHEET_ID=your-spreadsheet-id

# Cover letter rewrite (local Ollama)
COVER_LETTER_PROVIDER=ollama
JOB_ANALYSIS_PROVIDER=ollama
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_MODEL=ollama_chat/gemma4:e4b-mlx

# SQLite path (optional; default data/jobs.db)
# JOB_AGENT_DB_PATH=data/jobs.db

